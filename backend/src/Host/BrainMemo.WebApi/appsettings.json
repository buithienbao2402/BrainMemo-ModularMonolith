{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "brainmemo-api",
    "Audience": "brainmemo-web",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Identity": {
    "EmailVerificationTokenTtl": "24:00:00",
    "PasswordResetTokenTtl": "01:00:00"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Swagger": {
    "Enabled": false
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10,
    "DeduplicationCacheSize": 10000
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "brainmemo_minio",
    "SecretKey": "brainmemo_minio_dev_pw",
    "Bucket": "brainmemo-media",
    "Region": "auto",
    "ForcePathStyle": true,
    "UploadUrlTtlMinutes": 15,
    "DownloadUrlTtlMinutes": 15
  }
}

