{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "brainmemo-api",
    "Audience": "brainmemo-web",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Swagger": {
    "Enabled": false
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10,
    "DeduplicationCacheSize": 10000
  }
}

