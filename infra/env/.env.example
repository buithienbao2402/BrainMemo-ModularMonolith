# ==============================================================================
# BrainMemo LMS - Environment Variables Example (Development)
# Copy this file to repository root as `.env`:
#   cp infra/env/.env.example .env
# NEVER commit `.env` or real production secrets!
# ==============================================================================

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=brainmemo

# --- Service Ports ---
# Host port 3307 avoids conflicts with a local MySQL instance on 3306; change to 3306 if free.
MYSQL_PORT=3307
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
AI_SERVICE_PORT=8000

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=brainmemo_root_dev_pw
MYSQL_DATABASE=brainmemo_lms
MYSQL_USER=brainmemo
MYSQL_PASSWORD=brainmemo_dev_pw
ConnectionStrings__Default=Server=localhost;Port=3307;Database=brainmemo_lms;User=brainmemo;Password=brainmemo_dev_pw;SslMode=None;AllowPublicKeyRetrieval=True;

# --- Object Storage (MinIO in Dev / Cloudflare R2 in Prod) ---
MINIO_ROOT_USER=brainmemo_minio
MINIO_ROOT_PASSWORD=brainmemo_minio_dev_pw
MINIO_BUCKET=brainmemo-media

S3__Endpoint=http://localhost:9000
S3__AccessKey=brainmemo_minio
S3__SecretKey=brainmemo_minio_dev_pw
S3__Bucket=brainmemo-media
S3__Region=auto
S3__ForcePathStyle=true

# --- Email / SMTP (Mailpit in Dev) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseSsl=false
Smtp__From=noreply@brainmemo.local
Smtp__FromName=BrainMemo LMS
Smtp__Username=
Smtp__Password=

# --- JWT Authentication ---
Jwt__Issuer=brainmemo-api
Jwt__Audience=brainmemo-web
Jwt__SigningKey=replace-this-with-a-long-random-dev-secret-at-least-32-chars
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# --- Google OAuth (optional in early slices, used in S12) ---
GoogleAuth__ClientId=replace-with-google-client-id
GoogleAuth__ClientSecret=replace-with-google-client-secret

# --- AI Services (PhoBERT local + LLM API) ---
PhoBert__BaseUrl=http://localhost:8000
Llm__Provider=gemini
Llm__ApiKey=replace-with-gemini-api-key
Llm__Model=gemini-2.5-flash

# --- CORS & Frontend ---
Cors__AllowedOrigins=http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=false

